{
  "name": "dispatch",
  "version": "1.2.6",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "A local ticket workspace for your installed coding CLI, with isolated Git worktrees and real checks.",
  "bin": {
    "dispatch": "bin/dispatch.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "npm run build && node src/server.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "check": "node scripts/check.mjs",
    "test:unit": "node --test tests/*.test.mjs src/connectors/*/test/*.test.mjs",
    "e2e": "playwright test",
    "e2e:run": "playwright test --grep @run",
    "e2e:setup": "playwright test --grep @setup",
    "e2e:tasks": "playwright test --grep @tasks",
    "e2e:ui": "playwright test --grep @ui",
    "e2e:smoke": "playwright test --grep @smoke",
    "test": "npm run build && npm run test:unit",
    "test:e2e": "npm run build && npm run e2e",
    "test:all": "npm run check && npm test && npm run e2e",
    "live:smoke": "node scripts/live-smoke.mjs",
    "readme:media": "npm run build && node scripts/readme-demo/record.mjs",
    "dev:ui": "vite"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "^3.7.0"
  }
}
